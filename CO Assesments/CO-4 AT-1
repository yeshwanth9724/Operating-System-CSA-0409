1.)#include<stdio.h>
#define M 1000

int main(){
 int d[M]={0},n,s,m,i,j,c=0,k=-1;

 printf("Enter total number of disk blocks: "); scanf("%d",&n);
 printf("Enter file size (number of blocks): "); scanf("%d",&s);
 printf("\n1. Contiguous\n2. Linked\n3. Indexed\nEnter allocation method: ");
 scanf("%d",&m);

 if(s<=0||s>n){printf("Invalid file size.\n");return 0;}

 if(m==1){
  for(i=0;i<=n-s;i++){
   for(j=i;j<i+s&&d[j]==0;j++);
   if(j==i+s){k=i;break;}
  }
  if(k<0) printf("\nContiguous allocation failed.\nSufficient continuous space is not available.\n");
  else{
   printf("\nAllocated blocks: ");
   for(i=k;i<k+s;i++) d[i]=1,printf("%d ",i);
   printf("\n");
  }
 }
 else if(m==2){
  printf("\nAllocated blocks: ");
  for(i=0;i<n&&c<s;i++) if(!d[i]) d[i]=1,printf("%d ",i),c++;
  if(c<s) printf("\nAllocation failed. Not enough free blocks.\n");
  else printf("\nLinked allocation successful.\n");
 }
 else if(m==3){
  if(s+1>n){printf("\nIndexed allocation failed.\nNot enough blocks for index block and data blocks.\n");return 0;}
  for(i=0;i<n;i++) if(!d[i]){k=i;d[i]=1;break;}
  printf("\nIndex block: %d",k);
  printf("\nAllocated data blocks: ");
  for(i=0;i<n&&c<s;i++) if(!d[i]) d[i]=1,printf("%d ",i),c++;
  if(c<s) printf("\nAllocation failed.\n");
  else printf("\nIndexed allocation successful.\n");
 }
 else printf("\nInvalid allocation method.\n");

 return 0;
}

2.)#include<stdio.h>
#define M 1000

int main(){
 int b[M],n,i,r,c=0,x,q;

 printf("Enter total number of disk blocks: "); scanf("%d",&n);
 printf("Enter bitmap (0 = free, 1 = allocated):\n");
 for(i=0;i<n;i++) scanf("%d",&b[i]);

 printf("\nInitial Bitmap:\n");
 for(i=0;i<n;i++) printf("%d ",b[i]);

 printf("\n\nEnter number of blocks to allocate: "); scanf("%d",&r);
 for(i=0;i<n;i++) if(!b[i]) c++;

 if(c<r) printf("Allocation failed.\nOnly %d free blocks are available.\n",c);
 else{
  for(i=c=0;i<n&&c<r;i++) if(!b[i]) b[i]=1,c++;
  printf("Allocation successful.\nUpdated Bitmap after allocation:\n");
  for(i=0;i<n;i++) printf("%d ",b[i]);
 }

 printf("\n\nEnter number of blocks to deallocate: "); scanf("%d",&q);
 printf("Enter block numbers to deallocate:\n");

 while(q--){
  scanf("%d",&x);
  if(x>=0&&x<n){
   if(b[x]) b[x]=0,printf("Block %d deallocated.\n",x);
   else printf("Block %d is already free.\n",x);
  }else printf("Invalid block number: %d\n",x);
 }

 printf("\nFinal Bitmap:\n");
 for(i=0;i<n;i++) printf("%d ",b[i]);
 printf("\n");

 return 0;
}

3.)#include<stdio.h>
#include<stdlib.h>
#define M 100

void fcfs(int a[],int n,int h){
 int i,s=0;
 printf("\nFCFS Seek Sequence: %d",h);
 for(i=0;i<n;i++) s+=abs(h-a[i]),h=a[i],printf(" -> %d",h);
 printf("\nTotal Seek Time = %d\n",s);
}

void sstf(int a[],int n,int h){
 int v[M]={0},i,k,p,d,s=0;
 printf("\nSSTF Seek Sequence: %d",h);
 for(k=0;k<n;k++){
  for(i=0,d=99999;i<n;i++)
   if(!v[i]&&abs(h-a[i])<d)d=abs(h-a[i]),p=i;
  v[p]=1;s+=abs(h-a[p]);h=a[p];printf(" -> %d",h);
 }
 printf("\nTotal Seek Time = %d\n",s);
}

void scan(int a[],int n,int h,int z){
 int l[M],r[M],nl=0,nr=0,i,j,t,s=0;
 for(i=0;i<n;i++) if(a[i]<h)l[nl++]=a[i];else r[nr++]=a[i];

 for(i=0;i<nl-1;i++)for(j=i+1;j<nl;j++)if(l[i]>l[j])
  t=l[i],l[i]=l[j],l[j]=t;
 for(i=0;i<nr-1;i++)for(j=i+1;j<nr;j++)if(r[i]>r[j])
  t=r[i],r[i]=r[j],r[j]=t;

 printf("\nSCAN Seek Sequence: %d",h);
 for(i=0;i<nr;i++)s+=abs(h-r[i]),h=r[i],printf(" -> %d",h);
 s+=abs(h-z+1);h=z-1;printf(" -> %d",h);
 for(i=nl-1;i>=0;i--)s+=abs(h-l[i]),h=l[i],printf(" -> %d",h);
 printf("\nTotal Seek Time = %d\n",s);
}

int main(){
 int a[M],n,h,z,i;
 printf("Enter number of disk requests: ");scanf("%d",&n);
 printf("Enter request queue:\n");
 for(i=0;i<n;i++)scanf("%d",&a[i]);
 printf("Enter initial head position: ");scanf("%d",&h);
 printf("Enter disk size: ");scanf("%d",&z);

 fcfs(a,n,h);sstf(a,n,h);scan(a,n,h,z);
 printf("\nComparison: Lower seek time means better performance.\n");
 return 0;
}

