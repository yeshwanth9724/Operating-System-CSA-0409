#include<stdlib.h>
#define M 100

void cscan(int a[],int n,int h,int z,int d){
 int l[M],r[M],nl=0,nr=0,i,j,t,s=0;
 for(i=0;i<n;i++)if(a[i]<h)l[nl++]=a[i];else r[nr++]=a[i];

 for(i=0;i<nl-1;i++)for(j=i+1;j<nl;j++)if(l[i]>l[j])
  t=l[i],l[i]=l[j],l[j]=t;
 for(i=0;i<nr-1;i++)for(j=i+1;j<nr;j++)if(r[i]>r[j])
  t=r[i],r[i]=r[j],r[j]=t;

 printf("\nC-SCAN Seek Sequence: %d",h);

 if(d){
  for(i=0;i<nr;i++)s+=abs(h-r[i]),h=r[i],printf(" -> %d",h);
  s+=abs(h-z+1);h=z-1;printf(" -> %d",h);
  s+=z-1;h=0;printf(" -> %d",h);
  for(i=0;i<nl;i++)s+=abs(h-l[i]),h=l[i],printf(" -> %d",h);
 }else{
  for(i=nl-1;i>=0;i--)s+=abs(h-l[i]),h=l[i],printf(" -> %d",h);
  s+=h;h=0;printf(" -> %d",h);
  s+=z-1;h=z-1;printf(" -> %d",h);
  for(i=nr-1;i>=0;i--)s+=abs(h-r[i]),h=r[i],printf(" -> %d",h);
 }
 printf("\nTotal C-SCAN Head Movement = %d\n",s);
}

void look(int a[],int n,int h,int d){
 int l[M],r[M],nl=0,nr=0,i,j,t,s=0;
 for(i=0;i<n;i++)if(a[i]<h)l[nl++]=a[i];else r[nr++]=a[i];

 for(i=0;i<nl-1;i++)for(j=i+1;j<nl;j++)if(l[i]>l[j])
  t=l[i],l[i]=l[j],l[j]=t;
 for(i=0;i<nr-1;i++)for(j=i+1;j<nr;j++)if(r[i]>r[j])
  t=r[i],r[i]=r[j],r[j]=t;

 printf("\nLOOK Seek Sequence: %d",h);

 if(d){
  for(i=0;i<nr;i++)s+=abs(h-r[i]),h=r[i],printf(" -> %d",h);
  for(i=nl-1;i>=0;i--)s+=abs(h-l[i]),h=l[i],printf(" -> %d",h);
 }else{
  for(i=nl-1;i>=0;i--)s+=abs(h-l[i]),h=l[i],printf(" -> %d",h);
  for(i=0;i<nr;i++)s+=abs(h-r[i]),h=r[i],printf(" -> %d",h);
 }
 printf("\nTotal LOOK Head Movement = %d\n",s);
}

int main(){
 int a[M],n,h,z,d,i;
 printf("Enter number of disk requests: ");scanf("%d",&n);
 printf("Enter request queue:\n");
 for(i=0;i<n;i++)scanf("%d",&a[i]);
 printf("Enter initial head position: ");scanf("%d",&h);
 printf("Enter disk size: ");scanf("%d",&z);
 printf("Enter direction (1 = Right, 0 = Left): ");scanf("%d",&d);

 cscan(a,n,h,z,d);look(a,n,h,d);
 printf("\nComparison: Lower head movement means better efficiency.\n");
 return 0;
}

5.)#include<stdio.h>
#include<stdlib.h>
#define M 1000

int d[M];

void reset(int n){
 int i;
 for(i=0;i<n;i++)d[i]=0;
}

int con(int n,int s,int b[]){
 int i,j;
 for(i=0;i<=n-s;i++){
  for(j=i;j<i+s&&d[j]==0;j++);
  if(j==i+s){
   for(j=0;j<s;j++)d[i+j]=1,b[j]=i+j;
   return s;
  }
 }
 return 0;
}

int ind(int n,int s,int b[]){
 int i,c=0;
 if(s+1>n)return 0;
 for(i=0;i<n;i++)if(!d[i]){d[i]=1;break;}
 for(i=0;i<n&&c<s;i++)if(!d[i])d[i]=1,b[c++]=i;
 return c==s?s:0;
}

int fcfs(int a[],int n,int h){
 int i,s=0;
 printf("Seek Sequence: %d",h);
 for(i=0;i<n;i++)s+=abs(h-a[i]),h=a[i],printf(" -> %d",h);
 printf("\nTotal Seek Time = %d\n",s);
 return s;
}

int sstf(int a[],int n,int h){
 int v[M]={0},i,k,p,d,s=0;
 printf("Seek Sequence: %d",h);
 for(k=0;k<n;k++){
  for(i=0,d=999999;i<n;i++)
   if(!v[i]&&abs(h-a[i])<d)d=abs(h-a[i]),p=i;
  v[p]=1;s+=abs(h-a[p]);h=a[p];printf(" -> %d",h);
 }
 printf("\nTotal Seek Time = %d\n",s);
 return s;
}

void show(int b[],int n){
 int i;
 printf("Allocated Blocks: ");
 for(i=0;i<n;i++)printf("%d ",b[i]);
 printf("\n");
}

int main(){
 int n,s,a[M],rq,h,b[M],x,cf,cs,ifc,isf,best,ch,i;

 printf("Enter total number of disk blocks: ");scanf("%d",&n);
 printf("Enter file size: ");scanf("%d",&s);
 printf("Enter number of disk requests: ");scanf("%d",&rq);
 printf("Enter disk request queue:\n");
 for(i=0;i<rq;i++)scanf("%d",&a[i]);
 printf("Enter initial head position: ");scanf("%d",&h);

 reset(n);x=con(n,s,b);
 printf("\n====================================\nContiguous + FCFS\n====================================\n");
 if(!x)printf("Allocation failed.\n"),cf=999999;
 else show(b,x),cf=fcfs(b,x,h);

 reset(n);x=con(n,s,b);
 printf("\n====================================\nContiguous + SSTF\n====================================\n");
 if(!x)printf("Allocation failed.\n"),cs=999999;
 else show(b,x),cs=sstf(b,x,h);

 reset(n);x=ind(n,s,b);
 printf("\n====================================\nIndexed + FCFS\n====================================\n");
 if(!x)printf("Allocation failed.\n"),ifc=999999;
 else show(b,x),ifc=fcfs(b,x,h);

 reset(n);x=ind(n,s,b);
 printf("\n====================================\nIndexed + SSTF\n====================================\n");
 if(!x)printf("Allocation failed.\n"),isf=999999;
 else show(b,x),isf=sstf(b,x,h);

 printf("\n====================================\nPERFORMANCE COMPARISON\n====================================\n");

 printf("Contiguous + FCFS : ");
 cf==999999?printf("Allocation Failed\n"):printf("%d seek time\n",cf);
 printf("Contiguous + SSTF : ");
 cs==999999?printf("Allocation Failed\n"):printf("%d seek time\n",cs);
 printf("Indexed + FCFS    : ");
 ifc==999999?printf("Allocation Failed\n"):printf("%d seek time\n",ifc);
 printf("Indexed + SSTF    : ");
 isf==999999?printf("Allocation Failed\n"):printf("%d seek time\n",isf);

 best=cf;ch=1;
 if(cs<best)best=cs,ch=2;
 if(ifc<best)best=ifc,ch=3;
 if(isf<best)best=isf,ch=4;

 if(best==999999)printf("\nNo valid allocation was possible.\n");
 else{
  printf("\nBest Combination: ");
  if(ch==1)printf("Contiguous + FCFS");
  else if(ch==2)printf("Contiguous + SSTF");
  else if(ch==3)printf("Indexed + FCFS");
  else printf("Indexed + SSTF");
  printf("\nMinimum Seek Time = %d\n",best);
 }
 return 0;
}
