3.) a.) Required System Calls:open(),read(),write(),close()
(b)open() – Opens a file.
   close() – Closes the file after use.

c) C Program
#include <stdioh>
#include <unistd.h>

int main()
{
    int s, d;
    char ch;
    s = open("a.txt", O_RDONLY);
    d = creat("b.txt", 0644);
    while(read(s, &ch, 1) > 0)
        write(d, &ch, 1);
    close(s);
    close(d);
}

4.)a.)fork() – Creates a child process.
      exec() – Replaces the child process with another program.

b.) It makes the parent wait until the child finishes execution.

c.) C Program
#include <stdio.h>
#include <unistd.h>
int main()
{
    if(fork() == 0)
    {
        execl("/bin/ls", "ls", NULL);
    }
    else
    {
        wait(NULL);
        printf("Child completed\n");
    }
}

5.) a.) 
  Organizes files on secondary storage.
  Provides secure storage and retrieval of data.
  
b.)
  open() – Opens a file for read and write.
  close() – Closes the opened file.
(c) C Program
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int fd;
    char buf[100];
    fd = open("data.txt", O_RDONLY);
    read(fd, buf, sizeof(buf));
    write(1, buf, sizeof(buf));
    close(fd);
}
