#include <stdio.h>

int main()
{
    int n, i, j, temp;
    int bt[10], pr[10], p[10];

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        p[i] = i + 1;
        printf("Enter Burst Time of P%d: ", i + 1);
        scanf("%d", &bt[i]);
        printf("Enter Priority of P%d (Smaller number = Higher Priority): ", i + 1);
        scanf("%d", &pr[i]);
    }

    // Sort by priority (highest priority first)
    for(i = 0; i < n - 1; i++)
    {
        for(j = i + 1; j < n; j++)
        {
            if(pr[i] > pr[j])
            {
                temp = pr[i];
                pr[i] = pr[j];
                pr[j] = temp;

                temp = bt[i];
                bt[i] = bt[j];
                bt[j] = temp;

                temp = p[i];
                p[i] = p[j];
                p[j] = temp;
            }
        }
    }

    printf("\nExecution Order:\n");

    for(i = 0; i < n; i++)
    {
        printf("P%d (Priority=%d, Burst=%d)\n", p[i], pr[i], bt[i]);
    }

    return 0;
}
